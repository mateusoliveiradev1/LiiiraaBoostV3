{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {
      "cache": false,
      "outputs": []
    },
    "check": {
      "dependsOn": ["generate", "^check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["check", "^test"],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["generate", "^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"]
    }
  }
}
