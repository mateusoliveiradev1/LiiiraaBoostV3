{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": false,
    "outDir": "dist-types",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/**/*.json", "src/**/*.ts", "src/**/*.tsx"]
}
