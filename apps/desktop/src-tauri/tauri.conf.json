{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liiiraa Boost",
  "version": "0.0.0",
  "identifier": "com.liiiraa.boost",
  "build": { "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "Liiiraa Boost",
    "copyright": "Copyright © 2026 Liiiraa Boost. Todos os direitos reservados.",
    "license": "Proprietary",
    "licenseFile": "legal/TERMOS-DE-LICENCA-PT-BR.txt",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": null,
      "allowDowngrades": false,
      "nsis": {
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Liiiraa Boost",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "capabilities": [
        {
          "identifier": "main-shell",
          "description": "Defines a deny-by-default renderer boundary; native shell dispatch stays in Rust.",
          "windows": ["main"],
          "permissions": [
            "core:event:allow-listen",
            "core:window:allow-close",
            "core:window:allow-minimize",
            "core:window:allow-set-theme",
            "core:window:allow-start-dragging",
            "core:window:allow-toggle-maximize"
          ]
        }
      ]
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["liiiraa-boost"] } },
    "updater": { "endpoints": [], "pubkey": "", "windows": null },
    "liiiraa-shell": {
      "identity": {
        "publisher": "Liiiraa Boost",
        "version": "0.0.0",
        "channel": "development",
        "compatibility": { "windows": ["10", "11"] },
        "updater": {
          "signatureRequired": true,
          "publicKeyConfigured": false,
          "artifactsEnabled": false,
          "productionGate": "Phase 10"
        },
        "signing": {
          "class": "self-signed-development",
          "certificateOwnerPlan": "02-33",
          "timestamp": "not-applicable",
          "publicTrust": false,
          "smartScreenReputation": false,
          "productionReady": false,
          "distributionAllowed": false
        }
      }
    }
  }
}
