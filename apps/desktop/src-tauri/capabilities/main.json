{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-native-authority",
  "description": "Allows only named, validated desktop intents on the trusted main webview; privileged effects remain in the authenticated broker.",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "allow-apply-plan",
    "allow-approve-plan",
    "allow-bind-current-device",
    "allow-cancel-measurement-capture",
    "allow-compare-measurement-sessions",
    "allow-compose-plan",
    "allow-desktop-sign-in",
    "allow-desktop-sign-out",
    "allow-dispatch-shell-command",
    "allow-export-evidence-report",
    "allow-export-plan-diagnostic",
    "allow-finish-measurement-capture",
    "allow-get-shell-bootstrap",
    "allow-open-account-subscription",
    "allow-open-admin",
    "allow-prepare-device-binding",
    "allow-preview-plan-diagnostic",
    "allow-read-evidence-health",
    "allow-read-plan-execution",
    "allow-read-hardware-inventory",
    "allow-read-live-telemetry",
    "allow-refresh-hardware-inventory",
    "allow-render-evidence-report",
    "allow-restore-recovery-checkpoint",
    "allow-restore-plan-operation",
    "allow-restore-plan",
    "allow-revise-plan",
    "allow-sample-measurement-capture",
    "allow-start-measurement-capture",
    "allow-subscribe-plan-execution",
    "allow-sync-account"
  ]
}
