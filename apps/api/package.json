{
  "name": "@liiiraa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "tsx ../../packages/control-plane-adapters/src/postgres/staging-migration.ts",
    "db:migrate:test": "pnpm --dir ../../packages/control-plane-adapters exec vitest --run src/postgres/database.test.ts src/postgres/migrations.test.ts src/postgres/staging-migration.test.ts",
    "staging:provision-invitations": "tsx src/staging/provision-invitations.ts",
    "staging:provision-stripe": "tsx src/staging/provision-stripe.ts",
    "test": "node ./scripts/run-tests.mjs",
    "test:postgres": "vitest --config vitest.config.ts --run --mode postgres"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@liiiraa/contracts-ts": "workspace:*",
    "@liiiraa/control-plane-adapters": "workspace:*",
    "@liiiraa/control-plane-application": "workspace:*",
    "@liiiraa/control-plane-domain": "workspace:*",
    "fastify": "5.10.0",
    "stripe": "22.4.0",
    "tsx": "4.23.10"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
