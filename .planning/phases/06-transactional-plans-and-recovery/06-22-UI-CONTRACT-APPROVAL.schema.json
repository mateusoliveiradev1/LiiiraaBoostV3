{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.liiiraa.dev/ui-contract-approval-v1.schema.json",
  "title": "Liiiraa Boost UI Contract Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "subject", "checkerEvidence", "humanAcknowledgement"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "ui-contract-approval-v1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "path", "digest"],
      "properties": {
        "canonicalization": {
          "type": "string",
          "const": "ui-spec-review-payload-v1"
        },
        "path": {
          "type": "string",
          "const": ".planning/phases/06-transactional-plans-and-recovery/06-22-UI-CONTRACT-REVIEW-INPUT.md"
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "checkerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkerIdentity", "completedAtUtc", "report", "dimensions", "findingsDisposition"],
      "properties": {
        "checkerIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "provider", "runId"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "provider": { "type": "string", "minLength": 1 },
            "runId": { "type": "string", "minLength": 1 }
          }
        },
        "completedAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "digest"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "digest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "value"],
              "properties": {
                "algorithm": { "type": "string", "const": "sha256" },
                "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        },
        "dimensions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "verdict"],
            "properties": {
              "id": {
                "type": "string",
                "enum": ["copywriting", "visuals", "color", "typography", "spacing", "registry-safety"]
              },
              "verdict": { "type": "string", "const": "PASS" }
            }
          }
        },
        "findingsDisposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "detail"],
          "properties": {
            "status": { "type": "string", "enum": ["none-raised", "all-resolved"] },
            "detail": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "humanAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acknowledgedBy", "acknowledgedAtUtc", "reportSha256", "subjectSha256", "statement"],
      "properties": {
        "acknowledgedBy": { "type": "string", "minLength": 1 },
        "acknowledgedAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "reportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "subjectSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "statement": {
          "type": "string",
          "const": "I reviewed the independently produced checker report bound by this SHA-256 and approve this exact UI-SPEC."
        }
      }
    }
  }
}
