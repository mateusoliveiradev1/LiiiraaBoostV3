{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.liiiraaboost.com/phase5/evidence-manifest.schema.json",
  "title": "Liiiraa Boost Phase 5 evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "runKind",
    "generatedAt",
    "build",
    "environment",
    "gates",
    "budgets",
    "privacy",
    "report",
    "phase4PhysicalGaps"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/nonEmpty" },
    "runKind": {
      "enum": ["deterministic-ci", "local-development", "packaged-physical"]
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "build": { "$ref": "#/$defs/build" },
    "environment": { "$ref": "#/$defs/environment" },
    "gates": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/gate" }
    },
    "budgets": { "$ref": "#/$defs/budgets" },
    "privacy": { "$ref": "#/$defs/privacy" },
    "report": { "$ref": "#/$defs/artifactReference" },
    "phase4PhysicalGaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/physicalGap" }
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\*?{}]+$"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "collectorVersion", "artifactPath", "artifactSha256"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "collectorVersion": { "$ref": "#/$defs/nonEmpty" },
        "artifactPath": { "$ref": "#/$defs/relativePath" },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical", "os", "hardwareClasses"],
      "properties": {
        "physical": { "type": "boolean" },
        "os": { "$ref": "#/$defs/os" },
        "hardwareClasses": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/hardwareEvidence" }
        },
        "matrix": { "$ref": "#/$defs/matrix" }
      }
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "edition", "lifecycle", "version", "build", "architecture"],
      "properties": {
        "family": { "const": "windows" },
        "edition": { "$ref": "#/$defs/nonEmpty" },
        "lifecycle": {
          "enum": ["windows-11", "windows-10-ltsc-esu", "windows-10-unsupported"]
        },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "build": { "$ref": "#/$defs/nonEmpty" },
        "architecture": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "hardwareEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardwareClass", "state", "source"],
      "properties": {
        "hardwareClass": {
          "enum": [
            "cpu",
            "gpu",
            "memory",
            "storage",
            "network",
            "display",
            "audio",
            "usb",
            "windows",
            "drivers",
            "security",
            "games"
          ]
        },
        "state": { "enum": ["observed", "unavailable"] },
        "source": { "$ref": "#/$defs/nonEmpty" },
        "reasonCode": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "cpu", "gpu", "formFactor", "storage", "network"],
      "properties": {
        "os": { "enum": ["windows-10", "windows-11"] },
        "cpu": { "enum": ["intel", "amd", "other"] },
        "gpu": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["nvidia", "amd", "intel", "other"] },
          "uniqueItems": true
        },
        "formFactor": { "enum": ["desktop", "notebook", "other"] },
        "storage": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["nvme", "sata-ssd", "other"] },
          "uniqueItems": true
        },
        "network": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ethernet", "wifi", "other"] },
          "uniqueItems": true
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidenceKind", "evidenceSha256"],
      "properties": {
        "id": {
          "enum": [
            "contract",
            "conformance",
            "migration",
            "policy",
            "trace",
            "fault",
            "ui",
            "accessibility",
            "report",
            "tamper",
            "resource"
          ]
        },
        "status": { "enum": ["passed", "failed", "pending"] },
        "evidenceKind": { "enum": ["deterministic", "physical"] },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryPeakMb",
        "idleCpuPercent",
        "pollingHz",
        "cancellationMs",
        "sampleDurationSeconds"
      ],
      "properties": {
        "memoryPeakMb": { "type": "number", "minimum": 0 },
        "idleCpuPercent": { "type": "number", "minimum": 0 },
        "pollingHz": { "type": "number", "minimum": 0 },
        "cancellationMs": { "type": "number", "minimum": 0 },
        "sampleDurationSeconds": { "type": "number", "minimum": 0 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawIdentifiersFound", "scanSha256"],
      "properties": {
        "rawIdentifiersFound": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmpty" },
          "uniqueItems": true
        },
        "scanSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "physicalGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "detail"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["pending", "passed"] },
        "detail": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
