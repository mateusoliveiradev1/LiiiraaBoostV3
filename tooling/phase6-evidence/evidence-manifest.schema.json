{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.liiiraaboost.com/phase6/evidence-manifest.schema.json",
  "title": "Liiiraa Boost Phase 6 staged promotion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "operationVersion",
    "immutableBuild",
    "promotionStage",
    "requirementsCoverage",
    "decisionCoverage",
    "stages"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "operationVersion": { "$ref": "#/$defs/nonEmpty" },
    "immutableBuild": { "$ref": "#/$defs/immutableBuild" },
    "promotionStage": { "$ref": "#/$defs/stage" },
    "requirementsCoverage": {
      "type": "array",
      "items": { "enum": ["PLAN-01", "PLAN-05", "PLAN-06", "PLAN-07", "PLAN-08"] },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "decisionCoverage": {
      "type": "array",
      "items": { "type": "string", "pattern": "^D-(0[1-9]|[12][0-9]|3[0-5])$" },
      "minItems": 35,
      "maxItems": 35,
      "uniqueItems": true
    },
    "stages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/stageCell" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\*?{}]+$"
    },
    "stage": {
      "enum": ["deterministic-simulation", "clean-windows-vm", "owner-pc", "friends-pc"]
    },
    "immutableBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "commit", "artifact"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "artifact": { "$ref": "#/$defs/artifactReference" }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "stageCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "predecessorStage", "runEvidence", "humanReview"],
      "properties": {
        "stage": { "$ref": "#/$defs/stage" },
        "predecessorStage": {
          "oneOf": [{ "$ref": "#/$defs/stage" }, { "type": "null" }]
        },
        "runEvidence": {
          "oneOf": [{ "$ref": "#/$defs/runEvidence" }, { "type": "null" }]
        },
        "humanReview": { "$ref": "#/$defs/humanReview" }
      }
    },
    "runEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "evidenceKind",
        "status",
        "operationVersion",
        "buildId",
        "participantId",
        "recordedAt",
        "expiresAt",
        "artifacts",
        "cycle",
        "journalSha256",
        "receiptSha256",
        "security",
        "faults",
        "accessibility",
        "diagnostics",
        "revocation",
        "coverageGaps",
        "universalSupportClaim",
        "manualOverride"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "stage": { "$ref": "#/$defs/stage" },
        "evidenceKind": { "enum": ["deterministic", "physical"] },
        "status": { "enum": ["PASS", "FAIL"] },
        "operationVersion": { "$ref": "#/$defs/nonEmpty" },
        "buildId": { "$ref": "#/$defs/nonEmpty" },
        "participantId": { "$ref": "#/$defs/nonEmpty" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/artifactReference" }
        },
        "cycle": { "$ref": "#/$defs/cycle" },
        "journalSha256": { "$ref": "#/$defs/sha256" },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "security": { "$ref": "#/$defs/security" },
        "faults": { "$ref": "#/$defs/faults" },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "diagnostics": { "$ref": "#/$defs/diagnostics" },
        "revocation": { "$ref": "#/$defs/revocation" },
        "coverageGaps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmpty" },
          "uniqueItems": true
        },
        "universalSupportClaim": { "const": false },
        "manualOverride": { "const": false }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prepare",
        "apply",
        "verifyApply",
        "restartRequired",
        "restart",
        "restore",
        "verifyRestore"
      ],
      "properties": {
        "prepare": { "const": "PASS" },
        "apply": { "const": "PASS" },
        "verifyApply": { "const": "PASS" },
        "restartRequired": { "type": "boolean" },
        "restart": { "enum": ["PASS", "NOT_REQUIRED"] },
        "restore": { "const": "PASS" },
        "verifyRestore": { "const": "PASS" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ipcAdversarial",
        "replayRejected",
        "identitySpoofRejected",
        "sessionSwapRejected"
      ],
      "properties": {
        "ipcAdversarial": { "const": "PASS" },
        "replayRejected": { "const": true },
        "identitySpoofRejected": { "const": true },
        "sessionSwapRejected": { "const": true }
      }
    },
    "faults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diskFull", "crash", "reboot", "drift"],
      "properties": {
        "diskFull": { "const": "PASS" },
        "crash": { "const": "PASS" },
        "reboot": { "const": "PASS" },
        "drift": { "const": "PASS" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "seriousOrCriticalViolations"],
      "properties": {
        "status": { "const": "PASS" },
        "seriousOrCriticalViolations": { "const": 0 }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redacted", "previewed", "consentBound", "autoUpload", "rawFieldsFound"],
      "properties": {
        "redacted": { "const": true },
        "previewed": { "const": true },
        "consentBound": { "const": true },
        "autoUpload": { "const": false },
        "rawFieldsFound": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed",
        "blocksNewApply",
        "localRecoveryAvailable",
        "remoteRollback",
        "remoteExecution"
      ],
      "properties": {
        "signed": { "const": true },
        "blocksNewApply": { "const": true },
        "localRecoveryAvailable": { "const": true },
        "remoteRollback": { "const": false },
        "remoteExecution": { "const": false }
      }
    },
    "humanReview": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "enum": ["pending", "not-required"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "id",
            "reviewerId",
            "participantId",
            "recordedAt",
            "response",
            "verdict",
            "operationVersion",
            "buildId",
            "stage",
            "runEvidenceId",
            "runEvidenceSha256",
            "artifactHashes"
          ],
          "properties": {
            "status": { "enum": ["approved", "rejected"] },
            "id": { "$ref": "#/$defs/nonEmpty" },
            "reviewerId": { "$ref": "#/$defs/nonEmpty" },
            "participantId": { "$ref": "#/$defs/nonEmpty" },
            "recordedAt": { "type": "string", "format": "date-time" },
            "response": { "enum": ["APPROVED", "REJECTED"] },
            "verdict": { "enum": ["APPROVED", "REJECTED"] },
            "operationVersion": { "$ref": "#/$defs/nonEmpty" },
            "buildId": { "$ref": "#/$defs/nonEmpty" },
            "stage": { "$ref": "#/$defs/stage" },
            "runEvidenceId": { "$ref": "#/$defs/nonEmpty" },
            "runEvidenceSha256": { "$ref": "#/$defs/sha256" },
            "artifactHashes": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      ]
    }
  }
}
