{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.liiiraaboost.com/phase6/evidence-manifest.schema.json",
  "title": "Liiiraa Boost Phase 6 append-only promotion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "operationVersion",
    "immutableBuild",
    "promotionStage",
    "requirementsCoverage",
    "decisionCoverage",
    "legacyBlockedAttempts",
    "stages"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "operationVersion": { "$ref": "#/$defs/nonEmpty" },
    "immutableBuild": { "$ref": "#/$defs/immutableBuild" },
    "promotionStage": { "$ref": "#/$defs/stage" },
    "requirementsCoverage": {
      "type": "array",
      "items": {
        "enum": [
          "PLAN-01",
          "PLAN-02",
          "PLAN-03",
          "PLAN-04",
          "PLAN-05",
          "PLAN-06",
          "PLAN-07",
          "PLAN-08"
        ]
      },
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true
    },
    "decisionCoverage": {
      "type": "array",
      "items": { "type": "string", "pattern": "^D-(0[1-9]|[12][0-9]|3[0-5])$" },
      "minItems": 35,
      "maxItems": 35,
      "uniqueItems": true
    },
    "legacyBlockedAttempts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactReference" },
      "uniqueItems": true
    },
    "stages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/stageCell" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\*?{}]+$"
    },
    "stage": {
      "enum": ["deterministic-simulation", "clean-windows-vm", "owner-pc", "friends-pc"]
    },
    "immutableBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "commit", "artifact", "artifactManifestSha256"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "artifact": { "$ref": "#/$defs/artifactReference" },
        "artifactManifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "stageCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "predecessorStage", "friendsRoster", "runs", "consents", "reviews"],
      "properties": {
        "stage": { "$ref": "#/$defs/stage" },
        "predecessorStage": { "oneOf": [{ "$ref": "#/$defs/stage" }, { "type": "null" }] },
        "friendsRoster": { "oneOf": [{ "$ref": "#/$defs/friendsRoster" }, { "type": "null" }] },
        "runs": { "type": "array", "items": { "$ref": "#/$defs/runEvidence" } },
        "consents": { "type": "array", "items": { "$ref": "#/$defs/consent" } },
        "reviews": { "type": "array", "items": { "$ref": "#/$defs/review" } }
      }
    },
    "runEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "stage",
        "evidenceKind",
        "status",
        "operationVersion",
        "buildId",
        "participantId",
        "machineSlot",
        "artifactManifestSha256",
        "configSha256",
        "friendsRosterSha256",
        "predecessorRunEvidenceSha256",
        "recordedAt",
        "exportedAt",
        "expiresAt",
        "artifacts",
        "cycle",
        "continuation",
        "journalSha256",
        "receiptSha256",
        "security",
        "faults",
        "accessibility",
        "diagnostics",
        "revocation",
        "coverageGaps",
        "universalSupportClaim",
        "manualOverride"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "source": { "enum": ["phase6-deterministic-rust-1", "phase6-physical-runner-rust-1"] },
        "stage": { "$ref": "#/$defs/stage" },
        "evidenceKind": { "enum": ["deterministic", "physical"] },
        "status": { "enum": ["PASS", "FAIL"] },
        "operationVersion": { "$ref": "#/$defs/nonEmpty" },
        "buildId": { "$ref": "#/$defs/nonEmpty" },
        "participantId": { "$ref": "#/$defs/nonEmpty" },
        "machineSlot": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
        "artifactManifestSha256": { "$ref": "#/$defs/sha256" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "friendsRosterSha256": { "$ref": "#/$defs/nullableSha256" },
        "predecessorRunEvidenceSha256": { "$ref": "#/$defs/nullableSha256" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "exportedAt": {
          "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
        },
        "expiresAt": { "type": "string", "format": "date-time" },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/artifactReference" },
          "uniqueItems": true
        },
        "cycle": { "$ref": "#/$defs/cycle" },
        "continuation": {
          "const": [
            "installed-ready",
            "checkpoint-created",
            "reboot-requested",
            "resumed-observation",
            "restore-requested",
            "restored-complete"
          ]
        },
        "journalSha256": { "$ref": "#/$defs/sha256" },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "security": { "$ref": "#/$defs/security" },
        "faults": { "$ref": "#/$defs/faults" },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "diagnostics": { "$ref": "#/$defs/diagnostics" },
        "revocation": { "$ref": "#/$defs/revocation" },
        "coverageGaps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmpty" },
          "uniqueItems": true
        },
        "universalSupportClaim": { "const": false },
        "manualOverride": { "const": false }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prepare",
        "apply",
        "verifyApply",
        "restartRequired",
        "restart",
        "restore",
        "verifyRestore"
      ],
      "properties": {
        "prepare": { "const": "PASS" },
        "apply": { "const": "PASS" },
        "verifyApply": { "const": "PASS" },
        "restartRequired": { "type": "boolean" },
        "restart": { "enum": ["PASS", "NOT_REQUIRED"] },
        "restore": { "const": "PASS" },
        "verifyRestore": { "const": "PASS" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ipcAdversarial",
        "replayRejected",
        "identitySpoofRejected",
        "sessionSwapRejected"
      ],
      "properties": {
        "ipcAdversarial": { "const": "PASS" },
        "replayRejected": { "const": true },
        "identitySpoofRejected": { "const": true },
        "sessionSwapRejected": { "const": true }
      }
    },
    "faults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diskFull", "crash", "reboot", "drift"],
      "properties": {
        "diskFull": { "const": "PASS" },
        "crash": { "const": "PASS" },
        "reboot": { "const": "PASS" },
        "drift": { "const": "PASS" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "seriousOrCriticalViolations"],
      "properties": {
        "status": { "const": "PASS" },
        "seriousOrCriticalViolations": { "const": 0 }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redacted",
        "previewed",
        "consentBound",
        "autoUpload",
        "rawFieldsFound",
        "byteLength"
      ],
      "properties": {
        "redacted": { "const": true },
        "previewed": { "const": true },
        "consentBound": { "const": true },
        "autoUpload": { "const": false },
        "rawFieldsFound": { "type": "array", "maxItems": 0 },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 65536 }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed",
        "blocksNewApply",
        "localRecoveryAvailable",
        "remoteRollback",
        "remoteExecution"
      ],
      "properties": {
        "signed": { "const": true },
        "blocksNewApply": { "const": true },
        "localRecoveryAvailable": { "const": true },
        "remoteRollback": { "const": false },
        "remoteExecution": { "const": false }
      }
    },
    "friendsRoster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recordedAt",
        "operationVersion",
        "buildId",
        "artifactManifestSha256",
        "configSha256",
        "rosterSha256",
        "cmsSha256",
        "participants"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "operationVersion": { "$ref": "#/$defs/nonEmpty" },
        "buildId": { "$ref": "#/$defs/nonEmpty" },
        "artifactManifestSha256": { "$ref": "#/$defs/sha256" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "rosterSha256": { "$ref": "#/$defs/sha256" },
        "cmsSha256": { "$ref": "#/$defs/sha256" },
        "participants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["participantId", "machineSlot"],
            "properties": {
              "participantId": { "$ref": "#/$defs/nonEmpty" },
              "machineSlot": { "$ref": "#/$defs/nonEmpty" }
            }
          },
          "uniqueItems": true
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "participantId",
        "machineSlot",
        "recordedAt",
        "artifactManifestSha256",
        "configSha256",
        "friendsRosterSha256",
        "runEvidenceId",
        "runEvidenceSha256",
        "previewSha256",
        "redactedBytesSha256",
        "intent"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "participantId": { "$ref": "#/$defs/nonEmpty" },
        "machineSlot": { "$ref": "#/$defs/nonEmpty" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "artifactManifestSha256": { "$ref": "#/$defs/sha256" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "friendsRosterSha256": { "$ref": "#/$defs/sha256" },
        "runEvidenceId": { "$ref": "#/$defs/nonEmpty" },
        "runEvidenceSha256": { "$ref": "#/$defs/sha256" },
        "previewSha256": { "$ref": "#/$defs/sha256" },
        "redactedBytesSha256": { "$ref": "#/$defs/sha256" },
        "intent": { "enum": ["export", "send", "export-and-send"] }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reviewerId",
        "participantId",
        "machineSlot",
        "recordedAt",
        "response",
        "verdict",
        "operationVersion",
        "buildId",
        "stage",
        "artifactManifestSha256",
        "configSha256",
        "friendsRosterSha256",
        "runEvidenceId",
        "runEvidenceSha256",
        "consentId",
        "consentSha256",
        "artifactHashes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "reviewerId": { "$ref": "#/$defs/nonEmpty" },
        "participantId": { "$ref": "#/$defs/nonEmpty" },
        "machineSlot": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
        "recordedAt": { "type": "string", "format": "date-time" },
        "response": { "enum": ["APPROVED", "REJECTED"] },
        "verdict": { "enum": ["APPROVED", "REJECTED"] },
        "operationVersion": { "$ref": "#/$defs/nonEmpty" },
        "buildId": { "$ref": "#/$defs/nonEmpty" },
        "stage": { "$ref": "#/$defs/stage" },
        "artifactManifestSha256": { "$ref": "#/$defs/sha256" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "friendsRosterSha256": { "$ref": "#/$defs/nullableSha256" },
        "runEvidenceId": { "$ref": "#/$defs/nonEmpty" },
        "runEvidenceSha256": { "$ref": "#/$defs/sha256" },
        "consentId": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
        "consentSha256": { "$ref": "#/$defs/nullableSha256" },
        "artifactHashes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}
