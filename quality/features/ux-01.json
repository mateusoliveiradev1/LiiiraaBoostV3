          "owner": "plan-02-28",
          "status": "planned"
        },
        {
          "id": "ux-01-windows-10-image",
          "command": "node tooling/desktop-evidence/verify-packaged-wave-zero.mjs --environment quality/evidence/phase-02/environment --require-images-reviewed",
          "file": "quality/evidence/phase-02/environment/windows-10-image.json",
          "owner": "plan-02-28",
          "status": "planned"
        },
        {
          "id": "ux-01-windows-11-image",
          "command": "node tooling/desktop-evidence/verify-packaged-wave-zero.mjs --environment quality/evidence/phase-02/environment --require-images-reviewed",
          "file": "quality/evidence/phase-02/environment/windows-11-image.json",
          "owner": "plan-02-28",
          "status": "planned"
        }
      ]
    },
    "privacy": {
      "status": "tested",
      "evidence": [
        {
          "id": "ux-01-startup-redaction",
          "command": "pnpm --filter @liiiraa/desktop test -- --run -t \"startup|installer handoff\"",
