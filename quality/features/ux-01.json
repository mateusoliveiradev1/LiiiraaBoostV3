        {
          "id": "ux-01-forced-colors-observation",
          "command": "node tooling/desktop-evidence/verify-packaged-wave-zero.mjs --manual quality/evidence/phase-02/manual --require-observed",
          "file": "quality/evidence/phase-02/manual/forced-colors.json",
          "owner": "plan-02-28",
          "status": "planned"
