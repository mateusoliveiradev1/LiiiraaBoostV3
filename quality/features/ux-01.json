  "acceptance": {
    "security": {
      "status": "tested",
      "evidence": [
        {
          "id": "ux-01-development-signature",
          "command": "pnpm --filter @liiiraa/desktop test:packaged -- --grep \"@install-smoke|@native-smoke\"",
