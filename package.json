{
  "name": "@liiiraa/workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Deterministic modular workspace for Liiiraa Boost",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "generate": "turbo run generate",
    "check": "pnpm check:root && turbo run check",
    "check:root": "pnpm check:types && pnpm lint && pnpm format:check",
    "check:types": "tsc --version",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write package.json pnpm-workspace.yaml turbo.json tsconfig.base.json eslint.config.mjs prettier.config.mjs dependency-cruiser.config.mjs",
    "format:check": "prettier --check package.json pnpm-workspace.yaml turbo.json tsconfig.base.json eslint.config.mjs prettier.config.mjs dependency-cruiser.config.mjs",
    "docs:check": "prettier --check README.md architecture/README.md architecture/OWNERSHIP.md architecture/decisions/0003-module-ownership-and-direction.md architecture/decisions/0004-truth-provenance-and-fixture-boundary.md architecture/decisions/0005-cross-cutting-acceptance-policy.md",
    "test": "turbo run test",
    "test:adapters": "node tooling/adapter-conformance/run.mjs",
    "test:architecture": "node tooling/architecture-tests/src/check-workspace.ts && pnpm --filter @liiiraa/architecture-tests test -- --run",
    "test:runtime-truth": "pnpm --filter @liiiraa/fixture-guard test -- --run -t \"type-boundary|static|runtime\"",
    "test:production-truth": "pnpm --filter @liiiraa/fixture-guard test -- --run -t \"artifact|production smoke\"",
    "test:acceptance-policy": "pnpm --filter @liiiraa/acceptance-policy exec vitest --run",
    "acceptance:check": "node --experimental-strip-types tooling/acceptance-policy/src/policy.ts",
    "supply-chain:check": "node tooling/supply-chain/verify-pins.mjs --check",
    "verify:artifacts": "node tooling/ci/verify-required-artifacts.mjs",
    "contracts:generate": "pnpm --filter @liiiraa/contract-generation generate",
    "contracts:check": "pnpm --filter @liiiraa/contract-generation contracts:check",
    "contracts:compat": "pnpm --filter @liiiraa/contract-compat contracts:compat",
    "test:contracts": "pnpm contracts:check && pnpm contracts:compat && pnpm --filter @liiiraa/contracts-ts exec vitest --run && cargo test -p liiiraa-contracts-rust",
    "verify:workspace": "node tooling/workspace-smoke/check-toolchain.mjs",
    "build": "turbo run build",
    "verify:foundation:quick": "pnpm verify:workspace && pnpm format:check && pnpm check && pnpm contracts:check && pnpm contracts:compat && pnpm test:architecture && pnpm test:contracts && pnpm test:adapters && pnpm test:runtime-truth && pnpm test:acceptance-policy -- --mode planned && pnpm verify:artifacts",
    "verify:foundation": "pnpm verify:quick && pnpm test && pnpm build && pnpm test:production-truth && pnpm supply-chain:check && pnpm test:acceptance-policy -- --mode final && pnpm acceptance:check -- --mode final",
    "web:check": "turbo run check --filter=@liiiraa/web-core --filter=@liiiraa/web-preview --filter=@liiiraa/web-features --filter=@liiiraa/web-evidence --filter=@liiiraa/web --filter=@liiiraa/account --filter=@liiiraa/admin",
    "web:test": "turbo run test --filter=@liiiraa/web-core --filter=@liiiraa/web-preview --filter=@liiiraa/web-features --filter=@liiiraa/web-evidence --filter=@liiiraa/web --filter=@liiiraa/account --filter=@liiiraa/admin",
    "web:build": "turbo run build --filter=@liiiraa/web-core --filter=@liiiraa/web-preview --filter=@liiiraa/web-features --filter=@liiiraa/web-evidence --filter=@liiiraa/web --filter=@liiiraa/account --filter=@liiiraa/admin",
    "web:publication:check": "node --experimental-strip-types tooling/web-evidence/src/publication.ts",
    "web:verify:quick": "node tooling/web-evidence/run-web-verify.mjs",
    "web:verify:phase": "node --experimental-strip-types tooling/web-evidence/src/verify-phase.ts",
    "web:verify": "pnpm web:verify:quick && pnpm web:build && pnpm --filter @liiiraa/web-evidence exec playwright test && pnpm web:verify:phase -- --mode final",
    "phase4:verify": "node --experimental-strip-types tooling/phase4-evidence/src/evaluate.ts",
    "verify:quick": "pnpm --filter @liiiraa/desktop verify:quick && pnpm web:verify:quick",
    "verify": "pnpm --filter @liiiraa/desktop verify && pnpm web:verify"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
