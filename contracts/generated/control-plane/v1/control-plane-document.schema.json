{
  "$defs": {
    "AccountCommand": {
      "$id": "AccountCommand.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "accountId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "action": {
          "$ref": "AccountCommandAction.json"
        },
        "commandId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "correlationId": {
          "$ref": "CorrelationId.json"
        },
        "expectedVersion": {
          "type": "string"
        },
        "kind": {
          "const": "account-command",
          "type": "string"
        },
        "requestedAt": {
          "format": "date-time",
          "type": "string"
        },
        "schemaVersion": {
          "const": "1.0",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "commandId",
        "accountId",
        "action",
        "expectedVersion",
        "correlationId",
        "requestedAt"
      ],
      "type": "object",
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "AccountCommandAction": {
      "$id": "AccountCommandAction.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "update-profile",
          "type": "string"
        },
        {
          "const": "request-deletion",
          "type": "string"
        },
        {
          "const": "cancel-deletion",
          "type": "string"
        }
      ]
    },
    "AccountProjection": {
      "$id": "AccountProjection.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "accountId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "aggregateVersion": {
          "type": "string"
        },
        "correlationId": {
          "$ref": "CorrelationId.json"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "displayName": {
          "$ref": "ControlPlaneShortText.json"
        },
        "emailRedacted": {
          "$ref": "RedactedAuthorityText.json"
        },
        "etag": {
          "$ref": "AuthorityEtag.json"
        },
        "kind": {
          "const": "account-projection",
          "type": "string"
        },
        "locale": {
          "$ref": "ShellLocale.json"
        },
        "provenance": {
          "$ref": "AuthorityProvenance.json"
        },
        "schemaVersion": {
          "const": "1.0",
          "type": "string"
        },
        "state": {
          "$ref": "AccountState.json"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "aggregateVersion",
        "etag",
        "correlationId",
        "provenance",
        "kind",
        "accountId",
        "state",
        "displayName",
        "emailRedacted",
        "locale",
        "createdAt",
        "updatedAt"
      ],
      "type": "object",
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "AccountState": {
      "$id": "AccountState.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "active",
          "type": "string"
        },
        {
          "const": "locked",
          "type": "string"
        },
        {
          "const": "pending-deletion",
          "type": "string"
        },
        {
          "const": "disabled",
          "type": "string"
        }
      ]
    },
    "AdminAction": {
      "$id": "AdminAction.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "assume-role",
          "type": "string"
        },
        {
          "const": "view-support-diagnostics",
          "type": "string"
        },
        {
          "const": "revoke-session",
          "type": "string"
        },
        {
          "const": "revoke-device",
          "type": "string"
        },
        {
          "const": "correct-entitlement",
          "type": "string"
        },
        {
          "const": "export-audit-reference",
          "type": "string"
        }
      ]
    },
    "AdminCommand": {
      "$id": "AdminCommand.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "$ref": "AdminAction.json"
        },
        "actorId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "assumedRole": {
          "$ref": "AdminRole.json"
        },
        "authorizationContextId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "commandId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "correlationId": {
          "$ref": "CorrelationId.json"
        },
        "expectedVersion": {
          "type": "string"
        },
        "kind": {
          "const": "admin-command",
          "type": "string"
        },
        "reason": {
          "$ref": "RedactedAuthorityText.json"
        },
        "redactedTarget": {
          "$ref": "RedactedAuthorityText.json"
        },
        "requestedAt": {
          "format": "date-time",
          "type": "string"
        },
        "schemaVersion": {
          "const": "1.0",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "commandId",
        "actorId",
        "assumedRole",
        "action",
        "redactedTarget",
        "reason",
        "authorizationContextId",
        "expectedVersion",
        "correlationId",
        "requestedAt"
      ],
      "type": "object",
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "AdminRole": {
      "$id": "AdminRole.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "support",
          "type": "string"
        },
        {
          "const": "operations",
          "type": "string"
        },
        {
          "const": "security",
          "type": "string"
        },
        {
          "const": "audit",
          "type": "string"
        }
      ]
    },
    "AuditEvent": {
      "$id": "AuditEvent.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "actorReference": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "aggregateVersion": {
          "type": "string"
        },
        "assumedRole": {
          "$ref": "AdminRole.json"
        },
        "auditEventId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "correlationId": {
          "$ref": "CorrelationId.json"
        },
        "eventHash": {
          "$ref": "Sha256Digest.json"
        },
        "kind": {
          "const": "audit-event",
          "type": "string"
        },
        "occurredAt": {
          "format": "date-time",
          "type": "string"
        },
        "previousEventHash": {
          "$ref": "Sha256Digest.json"
        },
        "reason": {
          "$ref": "RedactedAuthorityText.json"
        },
        "redactedTarget": {
          "$ref": "RedactedAuthorityText.json"
        },
        "result": {
          "$ref": "AuditResult.json"
        },
        "schemaVersion": {
          "const": "1.0",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "auditEventId",
        "actorReference",
        "action",
        "redactedTarget",
        "reason",
        "result",
        "aggregateVersion",
        "correlationId",
        "eventHash",
        "occurredAt"
      ],
      "type": "object",
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "AuditResult": {
      "$id": "AuditResult.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "denied",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        }
      ]
    },
    "AuthenticationStrength": {
      "$id": "AuthenticationStrength.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "password",
          "type": "string"
        },
        {
          "const": "mfa",
          "type": "string"
        },
        {
          "const": "passkey",
          "type": "string"
        }
      ]
    },
    "AuthorityCommand": {
      "$id": "AuthorityCommand.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "$ref": "AccountCommand.json"
        },
        {
          "$ref": "SessionCommand.json"
        },
        {
          "$ref": "CommerceCommand.json"
        },
        {
          "$ref": "DeviceCommand.json"
        },
        {
          "$ref": "SupportCommand.json"
        },
        {
          "$ref": "ConsentCommand.json"
        },
        {
          "$ref": "AdminCommand.json"
        }
      ]
    },
    "AuthorityError": {
      "$id": "AuthorityError.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "auditReference": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "code": {
          "$ref": "AuthorityErrorCode.json"
        },
        "correlationId": {
          "$ref": "CorrelationId.json"
        },
        "currentEtag": {
          "$ref": "AuthorityEtag.json"
        },
        "currentVersion": {
          "type": "string"
        },
        "kind": {
          "const": "authority-error",
          "type": "string"
        },
        "message": {
          "$ref": "RedactedAuthorityText.json"
        },
        "retryable": {
          "type": "boolean"
        },
        "schemaVersion": {
          "const": "1.0",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "code",
        "message",
        "correlationId",
        "retryable"
      ],
      "type": "object",
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "AuthorityErrorCode": {
      "$id": "AuthorityErrorCode.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "unauthenticated",
          "type": "string"
        },
        {
          "const": "unauthorized",
          "type": "string"
        },
        {
          "const": "step-up-required",
          "type": "string"
        },
        {
          "const": "conflict",
          "type": "string"
        },
        {
          "const": "stale",
          "type": "string"
        },
        {
          "const": "consent-expired",
          "type": "string"
        },
        {
          "const": "offline",
          "type": "string"
        },
        {
          "const": "provider-unavailable",
          "type": "string"
        },
        {
          "const": "invalid-request",
          "type": "string"
        },
        {
          "const": "internal",
          "type": "string"
        }
      ]
    },
    "AuthorityEtag": {
      "$id": "AuthorityEtag.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "AuthorityProvenance": {
      "$id": "AuthorityProvenance.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "postgres-authority",
          "type": "string"
        },
        {
          "const": "provider-verified",
          "type": "string"
        },
        {
          "const": "device-verified",
          "type": "string"
        }
      ]
    },
    "AuthorityReceipt": {
      "$id": "AuthorityReceipt.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "aggregateId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "aggregateVersion": {
          "type": "string"
        },
        "auditReference": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "commandId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "correlationId": {
          "$ref": "CorrelationId.json"
        },
        "etag": {
          "$ref": "AuthorityEtag.json"
        },
        "kind": {
          "const": "authority-receipt",
          "type": "string"
        },
        "outcome": {
          "$ref": "AuthorityReceiptOutcome.json"
        },
        "provenance": {
          "$ref": "AuthorityProvenance.json"
        },
        "receiptId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "recordedAt": {
          "format": "date-time",
          "type": "string"
        },
        "schemaVersion": {
          "const": "1.0",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "receiptId",
        "commandId",
        "aggregateId",
        "aggregateVersion",
        "etag",
        "correlationId",
        "auditReference",
        "outcome",
        "provenance",
        "recordedAt"
      ],
      "type": "object",
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "AuthorityReceiptOutcome": {
      "$id": "AuthorityReceiptOutcome.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "applied",
          "type": "string"
        },
        {
          "const": "accepted",
          "type": "string"
        },
        {
          "const": "no-op",
          "type": "string"
        }
      ]
    },
    "CommerceCommand": {
      "$id": "CommerceCommand.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "accountId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "action": {
          "$ref": "CommerceCommandAction.json"
        },
        "commandId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "correlationId": {
          "$ref": "CorrelationId.json"
        },
        "expectedVersion": {
          "type": "string"
        },
        "kind": {
          "const": "commerce-command",
          "type": "string"
        },
        "requestedAt": {
          "format": "date-time",
          "type": "string"
        },
        "schemaVersion": {
          "const": "1.0",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "commandId",
        "accountId",
        "action",
        "expectedVersion",
        "correlationId",
        "requestedAt"
      ],
      "type": "object",
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "CommerceCommandAction": {
      "$id": "CommerceCommandAction.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "start-checkout",
          "type": "string"
        },
        {
          "const": "reconcile-subscription",
          "type": "string"
        },
        {
          "const": "cancel-subscription",
          "type": "string"
        }
      ]
    },
    "ConsentCommand": {
      "$id": "ConsentCommand.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "accountId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "action": {
          "$ref": "ConsentCommandAction.json"
        },
        "commandId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "consentId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "correlationId": {
          "$ref": "CorrelationId.json"
        },
        "expectedVersion": {
          "type": "string"
        },
        "kind": {
          "const": "consent-command",
          "type": "string"
        },
        "requestedAt": {
          "format": "date-time",
          "type": "string"
        },
        "schemaVersion": {
          "const": "1.0",
          "type": "string"
        },
        "scopes": {
          "items": {
            "$ref": "ConsentScope.json"
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "commandId",
        "accountId",
        "consentId",
        "action",
        "scopes",
        "expectedVersion",
        "correlationId",
        "requestedAt"
      ],
      "type": "object",
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "ConsentCommandAction": {
      "$id": "ConsentCommandAction.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "grant",
          "type": "string"
        },
        {
          "const": "revoke",
          "type": "string"
        }
      ]
    },
    "ConsentScope": {
      "$id": "ConsentScope.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "support-diagnostics",
          "type": "string"
        },
        {
          "const": "cloud-ai",
          "type": "string"
        },
        {
          "const": "account-security",
          "type": "string"
        }
      ]
    },
    "ConsentState": {
      "$id": "ConsentState.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "active",
          "type": "string"
        },
        {
          "const": "revoked",
          "type": "string"
        },
        {
          "const": "expired",
          "type": "string"
        }
      ]
    },
    "ContractSchemaVersion": {
      "$id": "ContractSchemaVersion.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
    },
    "ControlPlaneDocument": {
      "$id": "ControlPlaneDocument.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "$ref": "AccountProjection.json"
        },
        {
          "$ref": "SessionProjection.json"
        },
        {
          "$ref": "SubscriptionProjection.json"
        },
        {
          "$ref": "InvoiceProjection.json"
        },
        {
          "$ref": "DeviceBindingProjection.json"
        },
        {
          "$ref": "SupportCaseProjection.json"
        },
        {
          "$ref": "DiagnosticConsent.json"
        },
        {
          "$ref": "AuthorityCommand.json"
        },
        {
          "$ref": "AuthorityReceipt.json"
        },
        {
          "$ref": "AuthorityError.json"
        },
        {
          "$ref": "ProviderEvent.json"
        },
        {
          "$ref": "AuditEvent.json"
        },
        {
          "$ref": "OfflineEntitlementEnvelope.json"
        }
      ]
    },
    "ControlPlaneIdentifier": {
      "$id": "ControlPlaneIdentifier.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "ControlPlaneShortText": {
      "$id": "ControlPlaneShortText.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "CorrelationId": {
      "$id": "CorrelationId.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "CurrencyCode": {
      "$id": "CurrencyCode.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "maxLength": 3,
      "minLength": 3,
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "DetachedSignature": {
      "$id": "DetachedSignature.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "maxLength": 512,
      "minLength": 64,
      "pattern": "^[A-Za-z0-9_-]+={0,2}$",
      "type": "string"
    },
    "DeviceBindingProjection": {
      "$id": "DeviceBindingProjection.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "accountId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "aggregateVersion": {
          "type": "string"
        },
        "boundAt": {
          "format": "date-time",
          "type": "string"
        },
        "correlationId": {
          "$ref": "CorrelationId.json"
        },
        "deviceBindingId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "deviceLabel": {
          "$ref": "RedactedAuthorityText.json"
        },
        "etag": {
          "$ref": "AuthorityEtag.json"
        },
        "evidenceVersion": {
          "$ref": "ContractSchemaVersion.json"
        },
        "kind": {
          "const": "device-binding-projection",
          "type": "string"
        },
        "provenance": {
          "$ref": "AuthorityProvenance.json"
        },
        "replacementEligibleAt": {
          "format": "date-time",
          "type": "string"
        },
        "schemaVersion": {
          "const": "1.0",
          "type": "string"
        },
        "state": {
          "$ref": "DeviceBindingState.json"
        }
      },
      "required": [
        "schemaVersion",
        "aggregateVersion",
        "etag",
        "correlationId",
        "provenance",
        "kind",
        "deviceBindingId",
        "accountId",
        "state",
        "deviceLabel",
        "evidenceVersion"
      ],
      "type": "object",
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "DeviceBindingState": {
      "$id": "DeviceBindingState.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "const": "unbound",
          "type": "string"
        },
        {
          "const": "active",
          "type": "string"
        },
        {
          "const": "replacement-cooldown",
          "type": "string"
        },
        {
          "const": "revoked",
          "type": "string"
        }
      ]
    },
    "DeviceCommand": {
      "$id": "DeviceCommand.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "accountId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "action": {
          "$ref": "DeviceCommandAction.json"
        },
        "commandId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "correlationId": {
          "$ref": "CorrelationId.json"
        },
        "deviceBindingId": {
          "$ref": "ControlPlaneIdentifier.json"
        },
        "expectedVersion": {
          "type": "string"
        },
