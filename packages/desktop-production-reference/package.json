{
  "name": "@liiiraa/desktop-production-reference",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest"
  },
  "dependencies": {
    "@liiiraa/desktop-client": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
