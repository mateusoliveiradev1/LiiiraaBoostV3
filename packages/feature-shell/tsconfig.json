{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["react", "vitest"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
