{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.liiiraa.dev/architecture/module-boundaries.schema.json",
  "title": "Liiiraa Boost module boundary policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "layers", "modules", "exceptions"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "allowedDependencies"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "allowedDependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "layer", "roots", "publicRoots", "runtimeClass", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "$ref": "#/$defs/identifier"
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "publicRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "runtimeClass": {
          "enum": ["production", "fixture", "tooling"]
        },
        "status": {
          "enum": ["active", "reserved"]
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "from", "to", "reason"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "from": {
          "$ref": "#/$defs/identifier"
        },
        "to": {
          "$ref": "#/$defs/identifier"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
